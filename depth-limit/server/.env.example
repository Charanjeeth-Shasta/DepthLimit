# MongoDB Connection
# Format: mongodb://username:password@host:port,host:port/database?options
MONGO_URI=mongodb://user:password@cluster.mongodb.net/depthlimit?retryWrites=true&w=majority

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET=your-64-character-random-hex-secret-here-min-32-chars
JWT_REFRESH_SECRET=your-64-character-random-hex-refresh-secret-min-32-chars

# CORS Configuration
# Frontend origin for cross-origin requests
CLIENT_ORIGIN=http://localhost:5173
